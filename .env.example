# =============================================================================
# NEXUS SOC — Variables d'environnement (modèle)
# =============================================================================
# Copier en `.env` à la racine et remplir les valeurs.
# `.env` est ignoré par git (voir .gitignore). Ne JAMAIS le committer.
#
# Chargement automatique : run.py appelle `dotenv.load_dotenv()` au démarrage.
# =============================================================================


# ── 1. Base de données PostgreSQL / TimescaleDB ──────────────────────────────
# DSN du rôle applicatif (lectures + écritures sous RLS)
DB_DSN=postgresql://nexus_app:nexus_pass@localhost:5432/nexus

# DSN du rôle analyste (escalades, marquage faux positifs)
# Optionnel : si vide, dérivé automatiquement de DB_DSN
# DB_DSN_ANALYST=postgresql://nexus_analyst:nexus_pass@localhost:5432/nexus


# ── 2. Sécurité — JWT & pseudonymisation ─────────────────────────────────────
# Secret HMAC-SHA256 pour signer les JWT. EN PROD : 32 octets aléatoires.
#   openssl rand -base64 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_32_RANDOM_BYTES

# TTL des tokens
ACCESS_TOKEN_TTL_S=900           # 15 min
REFRESH_TOKEN_TTL_S=604800       # 7 jours

# Secret HMAC pour la pseudonymisation des identifiants (RGPD-like)
PSEUDO_SECRET=CHANGE_ME_PSEUDO_SECRET_32_BYTES
PSEUDO_ENABLED=true


# ── 3. CORS & URL publique ───────────────────────────────────────────────────
# Origines autorisées (séparées par virgule). Vide = défauts localhost.
# En prod via Cloudflare Tunnel : https://nexussoc.cm,https://api.nexussoc.cm
NEXUS_CORS_ORIGINS=

# URL publique du serveur (utilisée pour les liens dans les e-mails et la
# génération des installeurs d'agents)
NEXUS_SERVER_URL=https://nexussoc.cm
NEXUS_AGENT_VERSION=1.0.0


# ── 4. Kafka (pipeline temps réel) ───────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092
TELEMETRY_TOPIC=nexus.telemetry
RAW_TOPIC=nexus.telemetry.raw
ALERTS_TOPIC=nexus.alerts

# Seuils
RISK_THRESHOLD=70
MASS_FILE_THRESHOLD=20
MASS_FILE_WINDOW_S=300
CORR_WINDOW_MIN=30
ACCOUNT_CREATE_THRESHOLD=5

# Rate-limiting API
RATE_LIMIT_REQ=100
RATE_LIMIT_WIN=60
INGEST_LIMIT_REQ=30
INGEST_LIMIT_WIN=60


# ── 5. Modèles IA (Lot 3) ────────────────────────────────────────────────────
# Chemins des artefacts joblib (M1 = Isolation Forest, M2 = UEBA)
MODEL1_PATH=
MODEL2_PATH=

# Surveillance de dérive
DRIFT_SCORE_SIGMA=2.0
DRIFT_FP_RATE_MAX=0.20
DRIFT_ALERT_RATE_MIN=0.005
DRIFT_ALERT_RATE_MAX=0.15
PSI_WARNING=0.10
PSI_ALARM=0.25

# Mode LLM Analyst (optionnel — ex. Ollama local : http://localhost:11434/v1/chat/completions)
LLM_API_URL=
LLM_MODEL=mistral


# ── 6. Wazuh (intégration SIEM) ──────────────────────────────────────────────
WAZUH_API_URL=https://localhost:9200


# =============================================================================
# 7. SERVICES EXTERNES (intégrations production)
# =============================================================================

# ── 7a. Backend d'envoi d'e-mails ───────────────────────────────────────────
# Choix du backend : smtp (défaut, Gmail/Outlook/…) | mailjet | log
EMAIL_BACKEND=smtp

# TTL des codes OTP (en secondes) — s'applique aux 2 backends
OTP_TTL_S=300                    # 5 minutes

# ── 7a-1. SMTP (Gmail — mode par défaut) ────────────────────────────────────
# Prérequis Gmail : compte avec 2FA activée + mot de passe d'application créé
#   https://myaccount.google.com/apppasswords
# Le mdp d'app est une chaîne de 16 caractères style "abcd efgh ijkl mnop".
# Les espaces sont automatiquement ignorés par le client.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                    # 587 = STARTTLS (recommandé) | 465 = SSL
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=                 # vide = même que SMTP_USER
SMTP_FROM_NAME=NEXUS SOC
SMTP_MODE=live                   # live | log

# ── 7a-2. Mailjet (alternative si EMAIL_BACKEND=mailjet) ────────────────────
# Dashboard : https://app.mailjet.com/account/apikeys
# Plan gratuit : 200 e-mails/jour, 6000/mois
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=no-reply@nexussoc.cm
MAILJET_FROM_NAME=NEXUS SOC
MAILJET_MODE=log                 # log | sandbox | live


# ── 7b. CinetPay — pré-autorisation bancaire / paiement Mobile Money ────────
# Dashboard : https://admin.cinetpay.com → Intégration → Clés API
# Sandbox public : https://sandbox.cinetpay.com
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# Devise Cameroun = XAF (FCFA)
CINETPAY_CURRENCY=XAF

# Mode :
#   live    → https://api-checkout.cinetpay.com/v2/payment
#   sandbox → https://api-checkout.cinetpay.com/v2/payment (avec apikey de test)
#   stub    → pas d'appel HTTP (mode démo NEXUS SOC actuel)
CINETPAY_MODE=stub

# URL appelée par CinetPay pour notifier le résultat (webhook)
# Doit être HTTPS et publiquement joignable (via Cloudflare Tunnel par ex.)
CINETPAY_NOTIFY_URL=https://nexussoc.cm/plg/cinetpay/notify
CINETPAY_RETURN_URL=https://nexussoc.cm/app/landing.html#paiement-confirme


# ── 7c. VirusTotal — enrichissement IOC (SOAR) ──────────────────────────────
# Dashboard : https://www.virustotal.com/gui/my-apikey
# Plan public gratuit : 4 requêtes/min, 500/jour
VIRUSTOTAL_API_KEY=

# Cache local des verdicts (heures) — évite de re-questionner pour un même IOC
VIRUSTOTAL_CACHE_HOURS=24

# Active l'enrichissement automatique dans les playbooks SOAR
VIRUSTOTAL_ENABLED=false


# ── 8. Tests ─────────────────────────────────────────────────────────────────
NEXUS_BASE_URL=http://localhost:8000
NEXUS_TEST_PWD=admin
