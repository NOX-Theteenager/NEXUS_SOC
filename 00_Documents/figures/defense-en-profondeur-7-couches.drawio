                <mxCell id="99" value="Securisation de NEXUS SOC — defense en profondeur" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333333;fontFamily=Segoe UI;" parent="1" vertex="1">
                    <mxGeometry x="285" y="6" width="600" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="7. GOUVERNANCE&#xa;politiques, journal soar_audit, dossiers d&#39;enquete IRIS, conformite CEMAC et ISO 27001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;fontSize=12;fontStyle=1;fontFamily=Segoe UI;fontColor=#5b3a6b;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="40" width="1050" height="740" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="6. DETECTION&#xa;le SOC se surveille lui-meme : Wazuh sur les serveurs SOC, journal d&#39;audit immuable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;fontSize=12;fontStyle=1;fontFamily=Segoe UI;fontColor=#4f7a35;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="110" y="100" width="950" height="620" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="5. DONNEES&#xa;chiffrement au repos (LUKS) et en transit (TLS via PKI interne), pseudonymisation HMAC, sauvegardes chiffrees" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;fontSize=12;fontStyle=1;fontFamily=Segoe UI;fontColor=#3d5a80;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="160" y="160" width="850" height="500" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="4. APPLICATION&#xa;RBAC a 4 roles, JWT HMAC-SHA256, isolation au niveau des lignes, gestion des secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e8f2;strokeColor=#3d85c6;strokeWidth=2;verticalAlign=top;fontSize=12;fontStyle=1;fontFamily=Segoe UI;fontColor=#2a5f8f;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="210" y="220" width="750" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="3. HOTE et SYSTEME&#xa;durcissement systemd (NoNewPrivileges, ProtectSystem), SSH par cle, correctifs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;fontSize=12;fontStyle=1;fontFamily=Segoe UI;fontColor=#8a6100;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="260" y="280" width="650" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="2" value="2. RESEAU&#xa;six zones, air-gap de la zone sensible, OPNsense en refus par defaut, Suricata, sortie par zone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;fontSize=12;fontStyle=1;fontFamily=Segoe UI;fontColor=#7a6a1f;spacingTop=8;" parent="1" vertex="1">
