        <mxCell id="80" value="Politique de sortie Internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="530" height="130" as="geometry"/></mxCell>
        <mxCell id="81" value="Coeur SOC        sortie autorisee, liste blanche journalisee (depots, MISP, regles Wazuh)&#xa;Administration   sortie filtree (poste de travail reel)&#xa;DMZ / Applicatif  aucune sortie&#xa;Sensible         JAMAIS de sortie — air-gap, telemetrie vers le SOC uniquement&#xa;Menace           aucune sortie — le canal de commande reste simule en interne&#xa;&#xa;Le WAN est actif et filtre. Une politique se prouve ; une absence de cable ne prouve rien." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontFamily=Courier New;spacingLeft=4;" vertex="1" parent="80"><mxGeometry x="10" y="26" width="510" height="100" as="geometry"/></mxCell>

        <mxCell id="90" value="Un seul equipement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="600" y="660" width="535" height="130" as="geometry"/></mxCell>
        <mxCell id="91" value="La version precedente empilait pfSense en perimetre et MikroTik en routage&#xa;inter-zone. Le trafic lateral (menace vers app, app vers sensible) ne remontait&#xa;jamais jusqu&#39;a pfSense : bloquer une adresse sur le pare-feu de perimetre coupait&#xa;la machine du coeur SOC sans la couper de ses voisines.&#xa;&#xa;OPNsense porte les deux roles. Une adresse ajoutee a un alias est bloquee sur&#xa;tous les chemins, y compris entre deux zones internes." style="text;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=4;" vertex="1" parent="90"><mxGeometry x="10" y="26" width="515" height="100" as="geometry"/></mxCell>

        <mxCell id="95" value="Refus par defaut : tout flux non liste dans la matrice inter-zone est rejete et journalise." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="330" y="300" width="500" height="20" as="geometry"/></mxCell>
