                <mxCell id="40" value="Regles OPNsense sur l&#39;interface LAN_SENS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=11;fontStyle=1;fontFamily=Segoe UI;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" parent="1" vertex="1">
