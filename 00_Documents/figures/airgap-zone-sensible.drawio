        <!-- Preuve -->
        <mxCell id="20" value="Preuve (scenario 02) : depuis vm-antilope, ping 8.8.8.8 echoue, ping 10.50.20.20 echoue,&#xa;mais curl 10.50.0.2:8000/health reussit. Regle OPNsense : accept vers 10.50.0.2 (tcp 8000/443), drop pour tout le reste.&#xa;ARCHITECTURE CIBLE — la segmentation n'est pas deployee au 17 aout 2026 (phase 1)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=middle;fontSize=10;fontColor=#444444;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="600" height="80" as="geometry"/></mxCell>
